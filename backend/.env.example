# App
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3308
DB_NAME=peluqueria_db
DB_USER=peluqueria_user
DB_PASSWORD=peluqueria_pass
DB_ROOT_PASSWORD=root_pass

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRES_IN=7d

# Email (SMTP)
# Desarrollo: creá una cuenta en https://ethereal.email o usá Mailtrap free tier
# Producción: credenciales SMTP reales (ej: Resend, SendGrid, SES)
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=tu_usuario_ethereal
MAIL_PASS=tu_password_ethereal
MAIL_FROM=Tijerapp <noreply@tijerapp.com>

# Recordatorios — horas de anticipación con las que se envía el recordatorio (default 24)
REMINDER_WINDOW_HOURS=24
