# Entorno para los tests E2E (Playwright). Apunta a una DB MySQL separada
# (servicio docker-compose "db_test") para no tocar los datos de desarrollo.

# App
PORT=3002
NODE_ENV=test

# Database
DB_HOST=localhost
DB_PORT=3309
DB_NAME=tijerapp_test
DB_USER=tijerapp_test_user
DB_PASSWORD=tijerapp_test_pass
DB_ROOT_PASSWORD=root_pass

# JWT
JWT_SECRET=e2e_test_secret_not_for_prod
JWT_EXPIRES_IN=1d

# CORS — origen del frontend levantado para E2E (ver frontend/playwright.config.ts)
CORS_ORIGIN=http://localhost:4203
